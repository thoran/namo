#!/usr/bin/env ruby
# comparison/setup

# 20261104
# 0.1.1

# Builds the environments the scripts here run in, inside this directory:
# .venv/ for Python, with uv, and .tools/ for R, with micromamba from conda-forge,
# for Julia, from julialang.org's own tarball, and for the Ruby data libraries and
# those readme_claims.rb passes a Namo to, as gems with Apache Arrow's GLib
# libraries from conda-forge under them. Nothing is installed elsewhere.
#
# By default the versions are those COMPARISON.md, RUBY_COMPARISON.md, and the
# README were checked against, so that a run reproduces the dated comparison;
# --latest takes the newest releases instead, for checking it again. Each
# environment named, or all four, is removed and built afresh, and the downloads
# and package caches are removed after.

require 'digest'
require 'fileutils'
require 'json'
require 'open-uri'

ARROW_PACKAGES = {'arrow-c-glib' => '26.0.0'}
ENVIRONMENTS = %w{python r julia ruby}
JULIA_PACKAGES = {'DataFrames' => '1.8.2', 'RollingFunctions' => '0.8.1', 'Tables' => nil}
JULIA_VERSION = '1.13.3'
JULIA_VERSIONS_URL = 'https://julialang-s3.julialang.org/bin/versions.json'
MICROMAMBA_URL = 'https://micro.mamba.pm/api/micromamba/%s/latest'
PYTHON_PACKAGES = {'pandas' => '3.1.0', 'polars' => '2.1.0', 'xarray' => '2026.9.0', 'numpy' => '2.5.4', 'pyarrow' => '26.0.0'}
PYTHON_VERSION = '3.13.18'
R_PACKAGES = {'r-base' => '4.5.3', 'r-dplyr' => '1.2.1', 'r-tidyr' => '1.3.2', 'r-tibble' => '3.3.1', 'r-zoo' => '1.9_0'}
RUBY_GEMS = {'daru' => '0.3', 'matrix' => '0.4.3', 'rover-df' => '1.1.0', 'polars-df' => '0.27.1', 'red_amber' => '0.5.2', 'statistics.rb' => '0.11.0', 'terminal-table' => '4.0.0', 'vega' => '0.6.0'}

def usage
  puts "setup - Build the environments the scripts in comparison/ run in."
  puts
  puts "Usage: comparison/setup [--latest] [python] [r] [julia] [ruby]"
  puts
  puts "With no environment named, builds all four. Each is removed and built afresh."
  puts
  puts "Options:"
  puts "  -l, --latest  The newest releases, rather than the versions the comparisons name"
  puts "  -h, --help    Show this help"
end

def validate_args
  if ARGV.include?('-h') || ARGV.include?('--help')
    usage
    exit
  end
  unless (ARGV - %w{-l --latest} - ENVIRONMENTS).empty?
    usage
    exit 1
  end
end

def latest?
  @latest ||= ARGV.include?('-l') || ARGV.include?('--latest')
end

def environments
  @environments ||= (
    named = ENVIRONMENTS & ARGV
    named.empty? ? ENVIRONMENTS : named
  )
end

def comparison_directory
  @comparison_directory ||= File.expand_path(__dir__)
end

def tools_directory
  @tools_directory ||= File.join(comparison_directory, '.tools')
end

def tools_path(*parts)
  File.join(tools_directory, *parts)
end

def venv_directory
  @venv_directory ||= File.join(comparison_directory, '.venv')
end

def heading(text)
  puts
  puts "== #{text}"
end

def run(*command, env: {})
  puts command.join(' ')
  unless system(env, *command)
    $stderr.puts "Failed: #{command.join(' ')}"
    exit 1
  end
end

def download(url, path)
  puts "#{url} -> #{path}"
  File.binwrite(path, URI.open(url, &:read))
end

def remove(*paths)
  FileUtils.rm_rf(paths)
end

def macos?
  RbConfig::CONFIG['host_os'].include?('darwin')
end

def arm?
  RbConfig::CONFIG['host_cpu'].match?(/arm|aarch64/)
end

def uv_env
  {'UV_PYTHON_INSTALL_DIR' => tools_path('python'), 'UV_CACHE_DIR' => tools_path('uv-cache')}
end

def python_requirements
  PYTHON_PACKAGES.map{|name, version| latest? ? name : "#{name}==#{version}"}
end

def build_python
  heading 'Python'
  remove(venv_directory, tools_path('python'))
  run('uv', 'venv', '--python', (latest? ? '3' : PYTHON_VERSION), venv_directory, env: uv_env)
  run('uv', 'pip', 'install', '--python', File.join(venv_directory, 'bin', 'python'), *python_requirements, env: uv_env)
  remove(tools_path('uv-cache'))
end

def micromamba_platform
  "#{macos? ? 'osx' : 'linux'}-#{arm? ? (macos? ? 'arm64' : 'aarch64') : '64'}"
end

def micromamba
  tools_path('bin', 'micromamba')
end

def install_micromamba
  archive = tools_path('micromamba.tar.bz2')
  download(MICROMAMBA_URL % micromamba_platform, archive)
  run('tar', '-xjf', archive, '-C', tools_directory, 'bin/micromamba')
  remove(archive)
end

def r_specs
  R_PACKAGES.map{|name, version| latest? ? name : "#{name}=#{version}"}
end

def link_rscript
  FileUtils.ln_sf('../r/bin/Rscript', tools_path('bin', 'Rscript'))
end

def build_r
  heading 'R'
  remove(tools_path('r'), tools_path('mamba'), micromamba)
  install_micromamba
  run(micromamba, 'create', '-y', '-q', '-p', tools_path('r'), '-c', 'conda-forge', '--override-channels', *r_specs, env: {'MAMBA_ROOT_PREFIX' => tools_path('mamba')})
  remove(tools_path('mamba'))
  link_rscript
end

def julia_versions
  @julia_versions ||= JSON.parse(URI.open(JULIA_VERSIONS_URL, &:read))
end

def julia_version
  @julia_version ||= (
    if latest?
      julia_versions.select{|_version, release| release['stable']}.keys.max_by{|version| Gem::Version.new(version)}
    else
      JULIA_VERSION
    end
  )
end

def julia_os
  macos? ? 'mac' : 'linux'
end

def julia_arch
  arm? ? 'aarch64' : 'x86_64'
end

def julia_file
  @julia_file ||= julia_versions[julia_version]['files'].find do |file|
    file['os'] == julia_os && file['arch'] == julia_arch && file['extension'] == 'tar.gz'
  end
end

def verify_sha256(path, sha256)
  if Digest::SHA256.file(path).hexdigest == sha256
    puts "sha256 #{sha256} verified"
  else
    $stderr.puts "#{path} doesn't match sha256 #{sha256}."
    remove(path)
    exit 1
  end
end

def install_julia
  archive = tools_path('julia.tar.gz')
  download(julia_file['url'], archive)
  verify_sha256(archive, julia_file['sha256'])
  run('tar', '-xzf', archive, '-C', tools_directory)
  remove(archive)
end

def julia_env
  {'JULIA_DEPOT_PATH' => tools_path('julia-depot'), 'JULIA_PROJECT' => tools_path('julia-env')}
end

def julia_package_specs
  JULIA_PACKAGES.map do |name, version|
    version && !latest? ? %{PackageSpec(name="#{name}", version="#{version}")} : %{PackageSpec(name="#{name}")}
  end.join(', ')
end

def add_julia_packages
  run(tools_path("julia-#{julia_version}", 'bin', 'julia'), '-e', "using Pkg; Pkg.add([#{julia_package_specs}]); Pkg.precompile(); Pkg.gc()", env: julia_env)
end

# Sets the depot and the project, so that julia finds the packages added here.
def write_julia_wrapper
  path = tools_path('bin', 'julia')
  File.write(path, <<~SH)
    #!/bin/sh
    tools=$(cd "$(dirname "$0")/.." && pwd)
    export JULIA_DEPOT_PATH="$tools/julia-depot"
    export JULIA_PROJECT="$tools/julia-env"
    exec "$tools/julia-#{julia_version}/bin/julia" "$@"
  SH
  File.chmod(0755, path)
end

def build_julia
  heading 'Julia'
  remove(*Dir[tools_path('julia-[0-9]*')], tools_path('julia-depot'), tools_path('julia-env'))
  install_julia
  add_julia_packages
  write_julia_wrapper
end

def arrow_specs
  ARROW_PACKAGES.map{|name, version| latest? ? name : "#{name}=#{version}"}
end

def install_arrow
  run(micromamba, 'create', '-y', '-q', '-p', tools_path('arrow'), '-c', 'conda-forge', '--override-channels', *arrow_specs, env: {'MAMBA_ROOT_PREFIX' => tools_path('mamba')})
  remove(tools_path('mamba'))
end

# Red Arrow's version must be Arrow's, so it is read from what was installed.
def arrow_version
  File.read(tools_path('arrow', 'lib', 'pkgconfig', 'arrow-glib.pc'))[/^Version: (\S+)/, 1]
end

def gem_env
  {'GEM_HOME' => tools_path('ruby'), 'GEM_PATH' => tools_path('ruby'), 'PKG_CONFIG_PATH' => tools_path('arrow', 'lib', 'pkgconfig')}
end

def gem_specs
  ["red-arrow:#{arrow_version}"] + RUBY_GEMS.map{|name, version| latest? ? name : "#{name}:#{version}"}
end

def install_gems
  run(File.join(RbConfig::CONFIG['bindir'], 'gem'), 'install', '--no-document', *gem_specs, env: gem_env)
  remove(tools_path('ruby', 'cache'))
end

# Runs the Ruby which ran setup, with the gems and the Arrow libraries installed
# here. -W0, since GLib's bindings warn on load and would bury what the scripts
# print.
def write_ruby_wrapper
  path = tools_path('bin', 'ruby')
  File.write(path, <<~SH)
    #!/bin/sh
    tools=$(cd "$(dirname "$0")/.." && pwd)
    export GEM_HOME="$tools/ruby"
    export GEM_PATH="$tools/ruby"
    export GI_TYPELIB_PATH="$tools/arrow/lib/girepository-1.0"
    export DYLD_LIBRARY_PATH="$tools/arrow/lib"
    export LD_LIBRARY_PATH="$tools/arrow/lib"
    exec "#{RbConfig.ruby}" -W0 "$@"
  SH
  File.chmod(0755, path)
end

def build_ruby
  heading 'Ruby'
  remove(tools_path('ruby'), tools_path('arrow'), tools_path('mamba'), micromamba)
  install_micromamba
  install_arrow
  install_gems
  write_ruby_wrapper
end

def build_environments
  FileUtils.mkdir_p(tools_path('bin'))
  environments.each{|environment| send("build_#{environment}")}
end

def main
  validate_args
  build_environments
end

main
