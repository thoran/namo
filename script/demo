#!/usr/bin/env ruby
# demo

# 20260825
# 0.1.0

require 'date'
require 'io/console'
require 'stringio'

require_relative '../lib/namo'
require_relative './fixtures'
require_relative './Indicators'

def usage
  puts "demo - Run through the Namo demonstration."
  puts
  puts "Usage: script/demo [SECTION ... | talk]"
  puts
  puts "With no arguments, runs every section, pausing between them when attached to a terminal."
  puts "At a pause, the arrow keys move between sections, `i` opens irb on the section's"
  puts "own binding, and `q` quits."
  puts "`talk` runs the fifteen-minute cut, marked * below. Named sections run in the listed"
  puts "order rather than the order given:"
  puts
  all_sections.each{|section| puts "  #{talk_sections.include?(section) ? '*' : ' '} #{section}"}
end

def validate_args
  return unless ARGV.include?('-h') || ARGV.include?('--help') || sections.empty?
  usage
  exit(ARGV.empty? || ARGV.include?('-h') || ARGV.include?('--help') ? 0 : 1)
end

# One binding for the whole run, so a name bound in an early section is still
# bound in a later one.  Locals in a top-level method would not survive the
# call, which is what the instance variables were working around.
def context
  @context ||= binding
end

# Return moves to the next section.  Anything starting with an i opens irb on the
# same binding the sections have been using, so every name the transcript above
# put on the screen is still bound.  It is the console without the second window.
#
# Leaving irb comes back to the slide rather than moving on, so that a section can
# be poked at and then returned to, and so that an accidental ctrl-d does not
# advance the talk.
#
# Returns the number of sections to move by, so that one can be returned to
# rather than only left.
def pause(body)
  return 1 unless $stdin.tty?
  loop do
    case keypress
    when *BACK then return -1
    when *FORWARD then return 1
    when *QUIT then quit
    when 'i' then interact(body)
    end
  end
ensure
  release if $stdout.tty?
end

# One keypress, or the whole of an escape sequence.  The rest of a sequence
# arrives with the escape, so a bare escape reads as itself rather than waiting
# on one which is not coming.
def keypress
  $stdin.raw do |stdin|
    pressed = stdin.getc
    next pressed unless pressed == "\e"
    pressed + sequence(stdin)
  end
end

# Up to and including the byte which ends the sequence, rather than a fixed two:
# an arrow ends after three bytes and a clicker's page keys after four, and
# counting on the arrow would leave the tilde behind to be read as a keypress of
# its own.
def sequence(stdin)
  (+'').tap do |rest|
    while (byte = (stdin.read_nonblock(1) rescue nil))
      rest << byte
      break if rest.size > 1 && byte.match?(/[\x40-\x7e]/)
    end
  end
end

# The section keeps the rows it occupies and irb takes what is left of the window
# as its own scrolling region, so the session scrolls beneath a transcript which
# stays where it was rather than rolling off the top of the screen.
def interact(body)
  height, width = window_size
  # The rule sits above the region rather than in it, so irb cannot scroll it
  # away.
  top = [rows(body, width) + 2, height - IRB_ROWS + 1].min
  draw(body)
  print("\e[#{top - 1};1H#{RULE * width}")
  print("\e[#{top};#{height}r")
  print("\e[#{top};1H")
  context.irb(show_code: false)
ensure
  settle
  display(body)
end

# irb leaves the terminal however Reline left it, and leaves bytes in two places:
# the tty's own input queue, which iflush empties, and Ruby's IO buffer, which it
# does not.  A byte surviving in the second is returned by the next getc, so the
# keypress which should have been read is spent on it instead.
def settle
  $stdin.cooked!
  $stdin.iflush
  loop{$stdin.read_nonblock(4096)}
rescue IO::WaitReadable, EOFError, SystemCallError
  nil
end

def release
  print("\e[r")
end

# The terminal as cmd-k would leave it: the region released, and the screen and
# its scrollback both cleared.  Before the first section so that the talk does
# not open with the shell's leavings sitting above it, and on the way out so that
# none of the talk is left sitting behind the prompt.
def wipe
  return unless $stdout.tty?
  release
  print("\e[H\e[2J\e[3J")
end

# Running off the last section does not come through here, since that section is
# the one worth leaving on the screen.
def quit
  wipe
  exit
end

# Sections vary in length, which walks the title up and down the screen between
# one and the next.  Clearing puts the title on the first row; the padding after
# it covers whatever the shorter sections would otherwise leave showing
# underneath.  The constant is the fallback, and the bound the suite holds
# sections to.
SLIDE_HEIGHT = 40
SLIDE_WIDTH = 132
RULE = '─'

# The least irb is given.  A region of one row is degenerate — terminals ignore
# it and scroll the whole screen instead, taking the section with it — so a tall
# section gives up its last rows rather than the lot.
IRB_ROWS = 8

# What a pause answers to.  Arrows arrive as three bytes, which is why it reads
# raw rather than by the line.
# The O forms are the same arrows in application cursor mode, and the tilde forms
# are the page keys a presentation clicker sends in place of them.
FORWARD = ["\e[C", "\e[B", "\eOC", "\eOB", "\e[6~", "\r", "\n", ' ']
BACK = ["\e[D", "\e[A", "\eOD", "\eOA", "\e[5~"]
QUIT = ['q', "\u0003"]

def slide(section)
  previous, $stdout = $stdout, StringIO.new
  begin
    send(section)
    $stdout.string
  ensure
    $stdout = previous
  end
end

# Zero comes back from a pty without a controlling terminal, and is no more a
# size than the exception is.
def window_size
  height, width = $stdout.winsize
  height > 0 && width > 0 ? [height, width] : [SLIDE_HEIGHT + 1, SLIDE_WIDTH]
rescue SystemCallError, NoMethodError
  [SLIDE_HEIGHT + 1, SLIDE_WIDTH]
end

# A line wider than the window takes more than one row of it.  Padding which
# counted lines would leave a wrapped section that much too tall, and scroll the
# title off the top by the difference.
def rows(body, width)
  body.lines.sum{|line| [(line.chomp.size / width.to_f).ceil, 1].max}
end

# The region has to go before the clear, since a section which does not reach the
# bottom of the screen would otherwise be drawn inside the one irb left behind.
def draw(body)
  release
  print("\e[H\e[2J")
  print(body)
end

def display(body)
  return print(body) unless $stdout.tty?
  height, width = window_size
  draw(body)
  # One short of the window: the newline ending the last padded line would
  # otherwise scroll the title off the row the clear had just put it on.
  (height - 1 - rows(body, width)).times{puts}
end

def section(title, framing)
  puts
  puts "# #{title} — #{framing}"
  puts
end

def render_namo(namo)
  columns = namo.to_h
  return '(no dimensions)' if columns.empty?
  widths = columns.map{|dimension, values| [dimension.to_s.size, *values.map{|value| value.to_s.size}].max}
  rows = [columns.keys] + columns.values.first.size.times.map{|index| columns.values.map{|values| values[index]}}
  rows.map{|row| row.each_with_index.map{|cell, index| cell.to_s.ljust(widths[index])}.join('  ').rstrip}.join("\n")
end

def render(value, inspect: true)
  if value.is_a?(Namo) && !inspect
    render_namo(value)
  else
    value.inspect
  end
end

def indent(rendered)
  rendered.lines.map{|line| "      #{line}"}.join
end

def show(expression, inspect: true)
  rendered = render(eval(expression, context), inspect: inspect)
  puts "#{expression}"
  if rendered.include?("\n") && !inspect
    puts indent(rendered)
  else
    puts"  => #{rendered}"
  end
  puts
end

def setup(expression)
  puts "#{expression}"
  eval(expression, context)
  puts
end

def remark(text)
  puts "## #{text}"
end

def point(title, *lines)
  puts "#{title}"
  lines.each{|line| puts "    #{line}"}
  puts
end

def ensure_readings
  eval("readings = Namo.new(#{Fixtures.readings})", context)
end

def ensure_stations
  eval("stations = Namo.new(#{Fixtures.stations})", context)
end

def ensure_anomaly
  ensure_readings
  return if eval('readings.derived_dimensions.include?(:anomaly)', context)
  eval("readings[:anomaly] = #{Fixtures.anomaly}", context)
end

def ingestion
  section 'Ingestion', 'Nothing is declared on ingestion. Hash keys become dimensions, values become coordinates. No dimension is privileged.'
  setup "readings = Namo.new(#{Fixtures.readings})"
  show 'readings.dimensions'
  show 'readings.coordinates'
  remark "The same call selects on a label and on a measure."
  show "readings[station: 'Melbourne']"
  show 'readings[mean_temp: 30.0]'
end

def bracket_notation
  ensure_readings
  section 'The Bracket Notation', 'One syntax for matching exactly, by range, array, regex, and by proc.'
  remark 'Projection'
  show 'readings[:station, :high_temp]'
  remark "Contraction"
  show 'readings[-:mean_temp, -:rainfall]'
  remark "Selection by range"
  show "readings[rainfall: 50..60]"
  remark "Selection by array"
  show "readings[month: ['2025-01', '2025-02']]"
  remark "Selection by regex"
  show 'readings[station: /^M/]'
  remark "Selection by proc"
  show 'readings[rainfall: ->(v){v > 50.0}, high_temp: ->(v){v < 27.0}]'
  remark "Projection and selection together (projection precedes selection)"
  show "readings[:station, :month, :high_temp, high_temp: 30..., month: ['2025-01', '2025-02']]"
end

def formulae
  ensure_readings
  section 'Formulae are dimensions', 'A computed value is queryable exactly like a stored one.'
  setup "readings[:anomaly] = #{Fixtures.anomaly}"
  show 'readings.data_dimensions'
  show 'readings.derived_dimensions'
  show 'readings.dimensions'
  show 'readings.coordinates(:anomaly)'
  show 'readings[anomaly: 1.0..2.0]'
  remark 'change the source data and the derived dimension follows'
  setup 'readings.data[0][:high_temp] = 28.9'
  show 'readings.values(:anomaly)'
  remark 'and put back, the sections sharing one binding.'
  setup 'readings.data[0][:high_temp] = 26.4'
  show 'readings.values(:anomaly)'
end

def non_numeric
  section 'Not just numbers', 'The formula mechanism is type-agnostic: derive a String from a Date, then select and group by it.'
  setup "people = Namo.new([
    {first: 'Ada', last: 'Lovelace', born: Date.new(1815, 12, 10)},
    {first: 'Grace', last: 'Hopper', born: Date.new(1906, 12, 9)},
    {first: 'Karen', last: 'Spärck Jones', born: Date.new(1935, 8, 26)}
  ])"
  setup 'people[:full_name] = proc{|row| "#{row[:first]} #{row[:last]}"}'
  setup 'people[:century] = proc{|row| "C#{row[:born].year / 100 + 1}"}'
  show 'people[:full_name, :century]'
  show 'people[full_name: /^A/]'
  show 'people.coordinates(:century)'
  show "people[century: 'C20']"
end

# Requires measurand only when this section runs, so the script still works
# without it installed.
def measurand?
  require 'measurand'
  true
rescue LoadError
  false
end

def uncertainty
  section 'Duck typing', 'Same rows, same formula. Change column type and it just works.'
  unless measurand?
    puts '  (measurand is not installed, so this section is skipped)'
    puts
    return
  end
  setup "specimen_data = #{Fixtures.specimens}"
  setup 'data_with_floats = specimen_data.map(&:dup)'
  setup 'with_floats = Namo.new(data_with_floats)'
  setup 'with_floats[:area] = proc{|row| row[:length] * row[:width]}'
  show 'with_floats'
  remark 'The same lengths, with measurement error bands.'
  setup 'data_with_error = specimen_data.map{|row| row.merge(length: Measurand.new(row[:length], 0.05))}'
  setup 'with_measurand = Namo.new(data_with_error)'
  remark 'The formula is the one above, retyped unchanged.'
  setup 'with_measurand[:area] = proc{|row| row[:length] * row[:width]}'
  show 'with_measurand.values(:area)'
  remark 'Equal area, unequal confidence — which the Float column had discarded'
  show 'with_measurand[:specimen, :area]'
end

def parameterised
  section 'One formula, every parameterisation', 'Arguments arrive at access time, so one definition serves every column and every window.'
  setup "prices = Namo.new((1..5).map{|i| {symbol: 'AAA', date: i, close: i * 10.0, volume: i * 100}})"
  setup 'prices[:ma] = proc do |row, namo, field, period|
    window = namo[symbol: row[:symbol], date: ->(d){d <= row[:date]}].last(period)
    window.values(field).sum / window.count.to_f
  end'
  show 'prices.last[:ma, :close, 3]'
  show 'prices.last[:ma, :volume, 2]'
  remark 'a cross-row formula windows over the live collection, so an append moves it'
  setup "prices << {symbol: 'AAA', date: 6, close: 100.0, volume: 600}"
  show 'prices.last[:ma, :close, 3]'
end

def formularies
  section 'Formularies', 'Ruby modules as collections of operations, where public methods are the derived dimensions, private ones are helpers. Attach at runtime, detach again.'
  setup 'flows = Namo.new([
    {date: 1, buys: 60, sells: 40},
    {date: 2, buys: 80, sells: 120},
    {date: 3, buys: 75, sells: 75}
  ])'
  show 'flows.derived_dimensions'
  setup 'flows << Indicators'
  show 'flows.derived_dimensions'
  show 'flows'
  show 'flows.formulae[:signed_volume].class'
  remark 'We still know from where each formula came.'
  show 'flows.formulae[:signed_volume].owner'
  setup 'flows.detach(Indicators)'
  show 'flows.derived_dimensions'
  remark 'A proc written at the call site has no such handle.'
  setup 'flows[:net] = proc{|row| row[:buys] + row[:sells]}'
  show 'flows.formulae[:net].class'
end

def composition
  section 'Composition', 'Namos combine along their dimensions, and the products come apart again.'
  setup "stations = Namo.new(#{Fixtures.stations})"
  setup "months = Namo.new(#{Fixtures.months})"
  remark "Every station against every month."
  show 'stations ** months'
  remark "And division takes it back apart."
  show '(stations ** months) / months == stations'
  remark "A shared dimension joins rather than multiplies."
  setup "states = Namo.new([{station: 'Melbourne', state: 'VIC'}, {station: 'Perth', state: 'WA'}])"
  show 'stations * states'
end

def set_operations
  ensure_stations
  section 'Set operations', 'The row axis, where a Namo behaves as the multiset of rows it is.'
  setup "southern = Namo.new([{station: 'Melbourne'}, {station: 'Sydney'}])"
  remark "In either, in both, in one but not the other."
  show 'stations | southern'
  show 'stations & southern'
  show 'stations ^ southern'
  remark "Which are not three separate tricks: any two of them define the third."
  show '(stations | southern) - (stations & southern) == stations ^ southern'
  remark "Append is not union: + keeps the row that | folds away."
  show 'stations + southern'
end

def conditional_join
  section "Conditional Joins", "The block takes a Namo and returns a Namo."
  ensure_readings
  setup "tolerances = Namo.new(#{Fixtures.tolerances})"
  remark 'each reading paired with every sensor whose range covers it'
  show 'readings[:station, :high_temp].**(tolerances){|row, candidates| candidates[max_range: ->(r){r >= row[:high_temp]}]}'
  setup "calibrations = Namo.new(#{Fixtures.calibrations})"
  remark 'and each reading matched to the most recent calibration dated on or before it'
  show 'readings[:station, :month, :high_temp].*(calibrations){|row, candidates| candidates[calibrated: ->(c){c <= row[:month]}].sort_by{|r| r[:calibrated]}.last(1)}'
end

def collections
  ensure_anomaly
  section 'Collections are Namos', 'Partition into a collection, analyse collectively or separately, and reassemble exactly.'
  setup 'grouped = readings.group_by(:month)'
  show 'grouped.members.map(&:name)'
  show 'grouped.is_a?(Namo)'
  remark "Every row operation still applies, reading the detail view."
  show "grouped.detail[station: 'Melbourne'][:month, :high_temp, :rainfall]"
  remark "Summary will by default sum the values."
  show 'grouped.summary(:anomaly, by: :month)'
  remark "...unless a reducer is supplied. A reducer is any method to which the column responds."
  show 'grouped.summary(:anomaly, by: :month, reducer: :max)'
  remark 'And the partition inverts exactly!'
  show 'grouped.as_detail(:month) === readings'
end

def summary_block
  ensure_anomaly
  section 'A block for per-member work', 'One reducer names one column. A block returns the whole row, so several come at once.'
  show 'readings.group_by(:station).summary(by: :site) do |member|
    {months: member.count, warmest: member.max_by{|row| row[:anomaly]}[:month], anomaly: member.values(:anomaly).sum}
  end'
end

def shape_dispatch
  ensure_anomaly
  section "Data 'shape'", "A Namo matches another by its dimensions and its formula names, so a shape can dispatch incoming data."
  setup "shape = Namo.new([{station: '', month: '', high_temp: 0.0, mean_temp: 0.0, rainfall: 0.0}])"
  setup "shape[:anomaly] = #{Fixtures.anomaly}"
  remark 'same dimensions and formula names, different rows'
  show 'shape === readings'
  show 'shape == readings'
  show "shape === Namo.new([{site: 'Davis', ice_metres: 1.8}])"
  show '(case readings when shape then :weather_feed else :unknown end)'
end

def just_ruby
  ensure_anomaly
  section "It's just Ruby", 'No expression DSL, no string queries. Enumerable works, and the subset-returning methods hand back Namos.'
  show 'readings.map{|row| row[:station]}'
  show 'readings.reduce(0){|total, row| total + row[:anomaly]}'
  show 'readings.select{|row| row[:anomaly] > 0.5}[:station, :anomaly]'
  show 'readings.sort_by{|row| -row[:anomaly]}.first[:station]'
end

def whats_next
  section "What's next", 'Three directions, none of them built. The last two follow from the same property.'
  point 'Acceleration — columnar storage first, and C where it earns it',
    'The same computation: 19 ms in pandas, 58 in plain Ruby, 740 in Namo. The',
    'middle number is the language; the last one is mine, and it is allocation',
    'rather than arithmetic — 152 times as many objects for the same answer.'
  point '.namo — the portable analytical artefact',
    'Data, derived dimensions and structure travel together, so what you hand a',
    'colleague is an analysis they can query and extend, not a spreadsheet.'
  point 'Automatic parallelisation — a separate gem, and currently an idea',
    'Elsewhere you mark what may run in parallel. Here there is nothing to mark:',
    'a one-arity formula is already a pure function of its row, and freeze already',
    'says the shape is settled — neither of them written with parallelism in mind.'
  point 'The property underneath both',
    'A formula that is self-contained and nameable can travel: down a wire, or',
    'across a core. Serialisation and parallelisation want the same thing of it.'
end

def all_sections
  [
    :ingestion,
    :bracket_notation,
    :formulae,
    :non_numeric,
    :uncertainty,
    :parameterised,
    :formularies,
    :composition,
    :set_operations,
    :conditional_join,
    :collections,
    :summary_block,
    :shape_dispatch,
    :just_ruby,
    :whats_next,
  ]
end

# The cut which fits the slot: the six arguments in order, and the closer.  Named
# here rather than remembered at the podium, where seven names is six too many.
def talk_sections
  [
    :ingestion,
    :formulae,
    :non_numeric,
    :uncertainty,
    :composition,
    :collections,
    :whats_next,
  ]
end

def more_sections
  all_sections - talk_sections
end

def sections
  @sections ||= (
    if ARGV.empty?
      all_sections
    elsif ARGV.include?('talk')
      talk_sections
    elsif ARGV.include?('more')
      more_sections
    else
      all_sections.select{|section| ARGV.include?(section.to_s)}
    end
  )
end

def main
  validate_args
  wipe
  index = 0
  while index < sections.size
    body = slide(sections[index])
    display(body)
    index = [index + pause(body), 0].max
  end
rescue Interrupt
  # Ctrl-C anywhere but the raw read, where it arrives as an exception rather
  # than as a byte.  Quitting is what was asked for, so there is nothing to say
  # about it.
  quit
end

main
